{
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pip install -q -e:*)",
      "Bash(bash scripts/test_changed.sh:*)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm ci:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/stop_gate.sh"
          }
        ]
      }
    ]
  }
}
