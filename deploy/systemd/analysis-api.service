[Unit]
Description=Read-only decision-chain HTTP boundary for us-stock-helper
Documentation=file:///opt/us-stock-helper/services/analysis_api/README.md
# Ordered after the gateway but not dependent on it. When the gateway is down
# this service still answers, and answering "unavailable" is the contract.
After=market-gateway.service
Wants=market-gateway.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=usstock-api
Group=usstock-api
# No credential is named in this file or in the environment it reads: a phone's
# token is minted by the pairing exchange and lives in the database below.
# EnvironmentFile= is still used rather than Environment= because Environment=
# is readable by any local account through `systemctl show`, and the paths here
# are configuration an operator changes without editing a unit.
EnvironmentFile=/etc/us-stock-helper/analysis-api.env
WorkingDirectory=/opt/us-stock-helper
ExecStart=/usr/bin/python3 -m us_stock_helper_analysis_api
Restart=always
RestartSec=5

# The credential database is the one thing this service writes. ProtectSystem=
# strict and ProtectHome=yes below leave nothing else writable — the package's
# own default under ~/.us-stock-helper/ included — so systemd creates this
# directory, owns its mode, and keeps it out of the install tree that
# `python -m` imports from. DEVICE_AUTH_DATABASE must point inside it, and
# deploy/tests checks that it does.
StateDirectory=us-stock-helper-analysis-api
StateDirectoryMode=0700

StandardOutput=journal
StandardError=journal
SyslogIdentifier=us-stock-helper-analysis-api

# Caddy reaches this service over loopback and the service reaches the gateway
# over loopback. Nothing else is legitimate, so nothing else is permitted.
IPAddressDeny=any
IPAddressAllow=localhost

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
# This service is the standard library only, so write-execute memory has no
# legitimate use here and is refused outright.
MemoryDenyWriteExecution=yes

[Install]
WantedBy=multi-user.target
