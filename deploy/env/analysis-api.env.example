# Template for /etc/us-stock-helper/analysis-api.env — copy it there and keep
# it owned by root at mode 0600.
#
# ANALYSIS_API_ALLOW_LAN is set even though the bind address is loopback, and
# that combination is deliberate. It is the only switch that makes this service
# demand a bearer token; without it a request that arrives through Caddy is
# accepted unauthenticated, which would publish the whole decision chain to
# anyone who learns the hostname. The bind stays on loopback and the client
# allowlist stays on loopback, so the token is demanded of every caller while
# the socket itself remains unreachable from outside the host.
PYTHONPATH=/opt/us-stock-helper/services/analysis_api/src:/opt/us-stock-helper/services/analysis_core:/opt/us-stock-helper/services/information_layer:/opt/us-stock-helper/services/adviser_layer:/opt/us-stock-helper/services/decision_engine
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
ANALYSIS_API_HOST=127.0.0.1
ANALYSIS_API_PORT=8770
ANALYSIS_API_ALLOW_LAN=1
ANALYSIS_API_ALLOWED_CLIENTS=127.0.0.1/32
ANALYSIS_API_GATEWAY_URL=http://127.0.0.1:8765
# Left empty on purpose. deploy/issue-device-token.sh fills it in, and until it
# does the service refuses to start rather than serving without a token.
ANALYSIS_API_TOKEN=
