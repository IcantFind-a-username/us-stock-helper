# Template for /etc/us-stock-helper/analysis-api.env — copy it there and keep
# it owned by root at mode 0600.
#
# There is no secret in this file to fill in, and that is the point. A phone's
# credential is minted by the pairing exchange, stored hashed in the database
# below, and revocable one phone at a time; nothing an operator types into a
# file opens this service any more.
#
# ANALYSIS_API_TRUST_PROXY is what makes the service demand that credential.
# The bind address is loopback and so is the client allowlist, but behind Caddy
# every public request arrives from 127.0.0.1, so loopback stops being evidence
# of trust. Declaring the proxy also tells the service to count pairing
# attempts against the address Caddy observed rather than against its own
# doorstep, which is what keeps one stranger from locking every phone out.
PYTHONPATH=/opt/us-stock-helper/services/analysis_api/src:/opt/us-stock-helper/services/analysis_core:/opt/us-stock-helper/services/information_layer:/opt/us-stock-helper/services/adviser_layer:/opt/us-stock-helper/services/decision_engine:/opt/us-stock-helper/services/device_auth/src
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
ANALYSIS_API_HOST=127.0.0.1
ANALYSIS_API_PORT=8770
ANALYSIS_API_TRUST_PROXY=1
ANALYSIS_API_GATEWAY_URL=http://127.0.0.1:8765
# Paired devices, pairing codes and pairing attempts. The directory is created
# by the unit's StateDirectory= line and is the only path this service may
# write; the service refuses to start without this variable, because a service
# behind the proxy with no credential store is a public decision chain.
DEVICE_AUTH_DATABASE=/var/lib/us-stock-helper-analysis-api/device-auth.sqlite3

# The SEC requires a contact address in the User-Agent of every automated
# request; the evidence sources refuse to start without one rather than
# polling anonymously. Use an address you actually read — this is how the
# Commission reaches you if your polling causes a problem.
US_STOCK_HELPER_CONTACT_EMAIL=
