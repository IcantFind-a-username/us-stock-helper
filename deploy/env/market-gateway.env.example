# Template for /etc/us-stock-helper/market-gateway.env — copy it there and keep
# it owned by root at mode 0600.
#
# The gateway stays on loopback and therefore holds no token: the service drops
# a token it would never demand, and a credential that is configured but never
# checked reads as protection that does not exist. Caddy never proxies this
# port, so the only callers are the analysis API and anyone who already has a
# shell on the host.
PYTHONPATH=/opt/us-stock-helper/services/market_gateway/src:/opt/us-stock-helper/services/analysis_core
# The install tree is read-only at runtime, so a bytecode write would fail on
# every start; not attempting it keeps the journal free of noise that looks
# like a fault.
PYTHONDONTWRITEBYTECODE=1
# Without this the bind line and any startup error sit in a pipe buffer instead
# of reaching journald when they matter.
PYTHONUNBUFFERED=1
MOOMOO_GATEWAY_HOST=127.0.0.1
MOOMOO_GATEWAY_PORT=8765
