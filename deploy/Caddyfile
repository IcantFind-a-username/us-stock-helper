# The only public listener on this host.
#
# One upstream is reachable from here and it is the read-only analysis API on
# loopback. The market gateway and OpenD are deliberately absent: a second
# reverse_proxy line pointing at either would put the broker session's own data
# path, and in OpenD's case its control port, on the public internet. Anything
# that adds one is a defect, and deploy/tests guards against it.
#
# Replace stock.example.com and ops@example.com before installing. preflight.sh
# refuses a deployed file that still carries the placeholders.

{
	# The admin endpoint reconfigures the running server and asks for no
	# credential, so any local account could repoint the upstream.
	admin off
	# Port 80 is never opened by the firewall, so a redirect vhost would only
	# advertise a listener that is dropped, and the HTTP-01 challenge cannot
	# complete. TLS-ALPN on 443 is the challenge that works here.
	auto_https disable_redirects
	servers {
		# HTTP/3 would listen on UDP 443, which the firewall does not open.
		# Keeping the protocol list to TCP keeps the listeners and the
		# firewall rules describing the same surface.
		protocols h1 h2
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 2m
		}
	}
}

stock.example.com {
	tls {
		issuer acme {
			email ops@example.com
			disable_http_challenge
		}
	}

	# Only the pairing exchange sends a body, and it is a pairing code and a
	# name. Anything larger is refused here rather than streamed to the
	# service, which caps what it will read again on its own side.
	request_body {
		max_size 4KB
	}

	header {
		# preload is deliberately omitted. It commits the whole domain to a
		# browser-shipped list that is slow and awkward to leave, and that is
		# the operator's decision to make, not this file's.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		-Server
	}

	# Every matcher below names its method as well as its path, so that no
	# request can match two of them. That is deliberate and it is tested:
	# `handle` blocks are mutually exclusive, but which one wins is a question
	# about how Caddy orders routes, and the security of this file must not
	# rest on the answer. Disjoint matchers make the edge's reply the same
	# whatever that order turns out to be.

	# One write exists on this site and this is it. The pairing exchange has to
	# answer a phone that holds no credential yet, so it cannot be put behind
	# one; what protects it is the code — single use, minutes long, and rate
	# limited in the service's own database. A test ties this route to the
	# service's pairing path so the two cannot drift apart.
	@pairing {
		method POST
		path /v1/device-pairings
	}
	handle @pairing {
		reverse_proxy 127.0.0.1:8770 {
			# The service counts pairing attempts against this address, so it
			# has to be the address this proxy observed. Caddy otherwise
			# appends it to whatever the caller sent, and a caller who can
			# write their own history can rotate through as many rate-limit
			# buckets as they care to type.
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	# This list must equal the service's own read allowlist; a test ties the
	# two together so neither can grow a path the other does not know about.
	# The pairing path is deliberately absent: it is routed above, and a GET of
	# it belongs in the 404 below.
	@api {
		method GET
		path /health /decision
	}
	handle @api {
		reverse_proxy 127.0.0.1:8770
	}

	# Every write except the pairing exchange, refused here as well as in the
	# service, so it never reaches the process that holds the market session.
	# The path exclusion is what keeps this matcher disjoint from @pairing.
	@disallowed_method {
		not method GET
		not path /v1/device-pairings
	}
	handle @disallowed_method {
		header Allow "GET"
		respond 405
	}

	# Everything left: unlisted paths, and any method on the pairing path other
	# than the one it accepts.
	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# The device token is the phone's entire identity, so it must not be
		# written to a file that survives a log rotation and a backup. The
		# client address is masked because the log would otherwise record
		# where the user physically is, request by request.
		format filter {
			wrap console
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				# Caddy logs client_ip alongside remote_ip; masking only one
			# still writes the phone's real address next to the symbol it
			# asked for, which is a location and interest trail.
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}
}
